# ---- Data and intermediate arrays (never commit) ----
*.npy
*.npz
*.pkl
*.pickle
*.p
*.h5
*.hdf5
*.nwb
*.mat
*.parquet
*.feather
*.xlsx
*.json
*.log
*.out
*.so

# CSV files are ignored everywhere except the curated source tables
*.csv
!**/source_data/*.csv

# ---- Figures and documents produced by the scripts ----
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.eps
*.tif
*.tiff

# ---- Output / data directories the scripts write into ----
out/
results/
saves/
data/
figures/
fc/
npy/

# ---- Python / Jupyter ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
*.nbc
*.nbi

# ---- Environments and editor files ----
.venv/
venv/
env/
.env
.DS_Store
.idea/
.vscode/

# ---- Default output root (shared/paths.py: CITS_PAPER_OUT) ----
outputs/

# committed source data (overrides the *.json rule above)
!**/source_data/*.json
